# Server-only overrides. Loaded after root .env and .env.local by Node runtimes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Temporary compatibility alias. Prefer DATABASE_URL for new configuration.
PAYMENT_DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=tracksyra
WORKER_CONCURRENCY=5
WORKER_HTTP_PORT=8080
CORS_ORIGIN=*
PASSWORD_RESET_REDIRECT_URL=https://hello.tracksyra.com/reset-password

EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TrackSyra Team

MEDIA_STORAGE_PROVIDER=supabase
MEDIA_OUTPUT_BUCKET=media-private
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
